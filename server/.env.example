# ---------------------------------------------------------------- required ---
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/socialai
# 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ------------------------------------------------------------------ claude ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# ------------------------------------------------------- instagram / meta ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback
VERIFY_TOKEN=pick-any-string-and-paste-the-same-one-into-meta
IG_GRAPH_VERSION=v23.0
VERIFY_WEBHOOK_SIGNATURE=true

# --------------------------------------------------------------- optional ---
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
